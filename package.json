{
  "name": "game",
  "private": true,
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun run --hot src/server.ts",
    "ts": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "test": "bun test",
    "test:bots": "bun test src/tests/bots src/tests/botSeats.test.ts --max-concurrency 1",
    "bots:play": "bun scripts/bots/play.ts",
    "bots:records": "bun scripts/bots/records.ts",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.0",
    "eslint": "^10.5.0",
    "jiti": "^2.7.0",
    "typescript-eslint": "^8.61.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@socket.io/bun-engine": "^0.1.0",
    "micro-signals": "^2.4.0",
    "nodemailer": "^8.0.10",
    "seedrandom": "^3.0.5",
    "socket.io": "^4.8.3",
    "zod": "^4.1.13"
  }
}
